#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OBSWS="$SCRIPT_DIR/obsws.py"
AUDIOCTL="$SCRIPT_DIR/audioctl.py"
SAFETYCTL="$SCRIPT_DIR/safetyctl.py"
COLLABCTL="$SCRIPT_DIR/collabctl.py"
ONBOARDINGCTL="$SCRIPT_DIR/onboardingctl.py"
PROFILECTL="$SCRIPT_DIR/profilectl.py"
GUESTLAYOUT="$SCRIPT_DIR/guestlayout.py"
SETTINGSCTL="$SCRIPT_DIR/settings.py"
WITHSETTINGS="$SCRIPT_DIR/withsettings.py"
MIGRATE="$SCRIPT_DIR/migrate.py"
DIAGNOSTICS="$SCRIPT_DIR/diagnostics.py"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-streamer"
ACTIVE_FILE="$STATE_DIR/active"
PRIVACY_FILE="$STATE_DIR/privacy"
PREV_DND_FILE="$STATE_DIR/previous-dnd"
STATE_SCHEMA_FILE="$STATE_DIR/state-schema.json"

mkdir -p "$STATE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }
json_bool() { [[ "$1" == "true" ]] && printf 'true' || printf 'false'; }
file_bool() { [[ -e "$1" ]] && printf 'true' || printf 'false'; }

ensure_migrated() {
  if [[ ! -e "$STATE_SCHEMA_FILE" ]] && have python3; then
    python3 "$MIGRATE" >/dev/null 2>&1 || true
  fi
}

configured_python() {
  local script="$1"; shift
  python3 "$WITHSETTINGS" python3 "$script" "$@"
}

notifications_dnd_state() {
  if ! have omarchy-shell; then printf 'unknown'; return 0; fi
  local state
  state="$(omarchy-shell notifications dndState 2>/dev/null || true)"
  case "$state" in on|off) printf '%s' "$state" ;; *) printf 'unknown' ;; esac
}

privacy_enable() {
  if [[ -e "$PRIVACY_FILE" ]]; then return 0; fi
  local previous
  previous="$(notifications_dnd_state)"
  if [[ "$previous" == "unknown" ]]; then rm -f "$PREV_DND_FILE"; return 1; fi
  printf '%s\n' "$previous" > "$PREV_DND_FILE"
  chmod 600 "$PREV_DND_FILE" 2>/dev/null || true
  if ! omarchy-shell notifications setDnd on >/dev/null 2>&1; then rm -f "$PREV_DND_FILE"; return 1; fi
  : > "$PRIVACY_FILE"
  chmod 600 "$PRIVACY_FILE" 2>/dev/null || true
}

privacy_disable() {
  if [[ ! -e "$PRIVACY_FILE" ]]; then return 0; fi
  local previous="unknown"
  [[ -r "$PREV_DND_FILE" ]] && previous="$(head -n 1 "$PREV_DND_FILE" 2>/dev/null || true)"
  if have omarchy-shell; then case "$previous" in on|off) omarchy-shell notifications setDnd "$previous" >/dev/null 2>&1 || true ;; esac; fi
  rm -f "$PRIVACY_FILE" "$PREV_DND_FILE"
}

mode_enable() { : > "$ACTIVE_FILE"; chmod 600 "$ACTIVE_FILE" 2>/dev/null || true; privacy_enable || true; }
mode_disable() { privacy_disable; rm -f "$ACTIVE_FILE"; }
mode_toggle() { if [[ -e "$ACTIVE_FILE" ]]; then mode_disable; else mode_enable; fi; }

obs_launch() {
  if ! have obs; then printf 'error: OBS Studio is not installed or not on PATH\n' >&2; exit 4; fi
  if pgrep -x obs >/dev/null 2>&1; then return 0; fi
  nohup obs >/dev/null 2>&1 &
}

obs_status_json() {
  if ! pgrep -x obs >/dev/null 2>&1; then printf '%s' '{"connected":false,"streaming":null,"recording":null,"replayBuffer":null,"currentScene":"","error":"OBS is not running"}'; return 0; fi
  if ! have python3; then printf '%s' '{"connected":false,"streaming":null,"recording":null,"replayBuffer":null,"currentScene":"","error":"python3 is required for OBS control"}'; return 0; fi
  local raw
  raw="$(python3 "$OBSWS" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"connected":false,"streaming":null,"recording":null,"replayBuffer":null,"currentScene":"","error":"OBS WebSocket status failed"}'; fi
}

audio_status_json() {
  if ! have python3; then printf '%s' '{"ready":false,"sources":[],"selectedSourceName":"","selectedSourceId":null,"selectedPresent":false,"muted":null,"volumePercent":null,"error":"python3 is required for Audio Desk"}'; return 0; fi
  local raw
  raw="$(python3 "$AUDIOCTL" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"ready":false,"sources":[],"selectedSourceName":"","selectedSourceId":null,"selectedPresent":false,"muted":null,"volumePercent":null,"error":"Audio Desk status failed"}'; fi
}

safety_status_json() {
  if ! have python3; then printf '%s' '{"ready":false,"workspaceName":"","streamSafeActive":false,"sensitiveActive":false,"sensitiveRule":"","activeWindowClass":"","error":"python3 is required for Stream-Safe controls"}'; return 0; fi
  local raw
  raw="$(configured_python "$SAFETYCTL" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"ready":false,"workspaceName":"","streamSafeActive":false,"sensitiveActive":false,"sensitiveRule":"","activeWindowClass":"","error":"Stream-Safe status failed"}'; fi
}

collab_status_json() {
  if ! have python3; then
    printf '%s' '{"ready":false,"active":false,"provider":"","providerLabel":"","clipboardReady":false,"browserReady":false,"inviteReady":false,"programUrlReady":false,"managedSlotsReady":false,"guestControlReady":false,"slotCount":0,"guests":[],"obsSceneName":"","credentialsExposed":false,"error":"python3 is required for Collaboration"}'
    return 0
  fi
  local raw
  raw="$(configured_python "$COLLABCTL" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"ready":false,"active":false,"provider":"","providerLabel":"","clipboardReady":false,"browserReady":false,"inviteReady":false,"programUrlReady":false,"managedSlotsReady":false,"guestControlReady":false,"slotCount":0,"guests":[],"obsSceneName":"","credentialsExposed":false,"error":"Collaboration status failed"}'; fi
}

onboarding_status_json() {
  if ! have python3; then printf '%s' '{"ready":false,"tourVersion":1,"completed":false,"completedAt":null,"error":"python3 is required for onboarding"}'; return 0; fi
  local raw
  raw="$(python3 "$ONBOARDINGCTL" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"ready":false,"tourVersion":1,"completed":false,"completedAt":null,"error":"Onboarding status failed"}'; fi
}

profile_status_json() {
  if ! have python3; then printf '%s' '{"ready":false,"active":"gaming","activeLabel":"Gaming","guestRefreshSeconds":30,"guestLayout":"auto","privacyRecommended":true,"profiles":[],"error":"python3 is required for profiles"}'; return 0; fi
  local raw
  raw="$(python3 "$PROFILECTL" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"ready":false,"active":"gaming","activeLabel":"Gaming","guestRefreshSeconds":30,"guestLayout":"auto","privacyRecommended":true,"profiles":[],"error":"Profile status failed"}'; fi
}

settings_status_json() {
  if ! have python3; then printf '%s' '{"ready":false,"schemaVersion":1,"values":{},"sources":{},"error":"python3 is required for settings"}'; return 0; fi
  local raw
  raw="$(python3 "$SETTINGSCTL" status 2>/dev/null || true)"
  if [[ "$raw" == \{*\} ]]; then printf '%s' "$raw"; else printf '%s' '{"ready":false,"schemaVersion":1,"values":{},"sources":{},"error":"Settings status failed"}'; fi
}

run_obs_action() { local action="$1" arg="${2:-}"; if ! pgrep -x obs >/dev/null 2>&1; then printf 'error: OBS is not running\n' >&2; exit 6; fi; if ! have python3; then printf 'error: python3 is required for OBS WebSocket control\n' >&2; exit 6; fi; python3 "$OBSWS" action "$action" "$arg"; }
run_audio_action() { local action="$1" arg="${2:-}"; if ! have python3; then printf 'error: python3 is required for Audio Desk\n' >&2; exit 7; fi; python3 "$AUDIOCTL" action "$action" "$arg"; }
run_safety_action() { local action="$1"; if ! have python3; then printf 'error: python3 is required for Stream-Safe controls\n' >&2; exit 9; fi; configured_python "$SAFETYCTL" action "$action"; }
run_collab_action() { local action="$1" arg="${2:-}"; if ! have python3; then printf 'error: python3 is required for Collaboration\n' >&2; exit 10; fi; configured_python "$COLLABCTL" action "$action" "$arg"; }
run_onboarding_action() { local action="$1"; if ! have python3; then printf 'error: python3 is required for onboarding\n' >&2; exit 11; fi; python3 "$ONBOARDINGCTL" action "$action"; }
run_profile_action() { local action="$1" arg="${2:-}"; if ! have python3; then printf 'error: python3 is required for profiles\n' >&2; exit 13; fi; python3 "$PROFILECTL" action "$action" "$arg"; }
run_layout_action() { local preset="$1"; if ! pgrep -x obs >/dev/null 2>&1; then printf 'error: OBS is not running\n' >&2; exit 12; fi; if ! have python3; then printf 'error: python3 is required for guest layouts\n' >&2; exit 12; fi; configured_python "$GUESTLAYOUT" "$preset"; }
run_migration() { if ! have python3; then printf 'error: python3 is required for state migration\n' >&2; exit 15; fi; python3 "$MIGRATE"; }

run_settings_action() {
  local action="$1" arg="${2:-}"
  if ! have python3; then printf 'error: python3 is required for settings\n' >&2; exit 14; fi
  case "$action" in
    settings.set)
      if [[ "$arg" != *=* ]]; then printf 'error: settings.set expects key=value\n' >&2; exit 14; fi
      python3 "$SETTINGSCTL" set "${arg%%=*}" "${arg#*=}"
      ;;
    settings.reset) python3 "$SETTINGSCTL" reset "$arg" ;;
  esac
}

profile_layout() {
  if ! have python3; then printf 'error: python3 is required for profiles\n' >&2; exit 13; fi
  local preset
  preset="$(python3 "$PROFILECTL" status | python3 -c 'import json,sys; print(json.load(sys.stdin).get("guestLayout","auto"))')"
  run_layout_action "$preset"
}

onboarding_open() {
  local mode="${1:-tour}"
  case "$mode" in first-run|tour|preflight) ;; *) mode="tour" ;; esac
  if ! have omarchy-shell; then printf 'error: omarchy-shell is required to open the guided tour\n' >&2; exit 11; fi
  omarchy-shell shell summon io.github.drecullith.streamer "{\"mode\":\"$mode\"}" >/dev/null
  printf '{"ok":true,"action":"onboarding.open","mode":"%s"}\n' "$mode"
}

best_effort_obs() { local action="$1"; if pgrep -x obs >/dev/null 2>&1 && have python3; then python3 "$OBSWS" action "$action" "" >/dev/null 2>&1 || true; fi; }

emergency_action() {
  local action="$1" privacy_ok=false mic_ok=false workspace_ok=false
  if privacy_enable; then privacy_ok=true; fi
  if have python3 && python3 "$AUDIOCTL" action mic.mute "" >/dev/null 2>&1; then mic_ok=true; fi
  if have python3 && configured_python "$SAFETYCTL" action workspace.enter >/dev/null 2>&1; then workspace_ok=true; fi
  best_effort_obs stream.stop
  if [[ "$action" == "emergency.stop-all" ]]; then best_effort_obs record.stop; best_effort_obs replay.stop; fi
  printf '{"ok":true,"action":"%s","privacy":%s,"micMuted":%s,"streamSafeWorkspace":%s}\n' "$action" "$(json_bool "$privacy_ok")" "$(json_bool "$mic_ok")" "$(json_bool "$workspace_ok")"
}

status_json() {
  local active privacy obs_installed obs_running pipewire_ready wpctl_installed python_ready dnd_state dnd_managed obs_ws audio safety collab onboarding profiles settings
  active="$(file_bool "$ACTIVE_FILE")"; privacy="$(file_bool "$PRIVACY_FILE")"
  have obs && obs_installed=true || obs_installed=false
  pgrep -x obs >/dev/null 2>&1 && obs_running=true || obs_running=false
  pgrep -x pipewire >/dev/null 2>&1 && pipewire_ready=true || pipewire_ready=false
  have wpctl && wpctl_installed=true || wpctl_installed=false
  have python3 && python_ready=true || python_ready=false
  dnd_state="$(notifications_dnd_state)"
  if [[ -r "$PREV_DND_FILE" ]] && [[ "$(head -n 1 "$PREV_DND_FILE" 2>/dev/null || true)" != "unknown" ]]; then dnd_managed=true; else dnd_managed=false; fi
  obs_ws="$(obs_status_json)"; audio="$(audio_status_json)"; safety="$(safety_status_json)"; collab="$(collab_status_json)"; onboarding="$(onboarding_status_json)"; profiles="$(profile_status_json)"; settings="$(settings_status_json)"
  printf '{"version":10,"active":%s,"privacy":%s,"obsInstalled":%s,"obsRunning":%s,"pipewireReady":%s,"wpctlInstalled":%s,"pythonReady":%s,"dndState":"%s","dndManaged":%s,"obsWebSocket":%s,"audio":%s,"safety":%s,"collaboration":%s,"onboarding":%s,"profiles":%s,"settings":%s}\n' \
    "$(json_bool "$active")" "$(json_bool "$privacy")" "$(json_bool "$obs_installed")" "$(json_bool "$obs_running")" "$(json_bool "$pipewire_ready")" "$(json_bool "$wpctl_installed")" "$(json_bool "$python_ready")" "$dnd_state" "$(json_bool "$dnd_managed")" "$obs_ws" "$audio" "$safety" "$collab" "$onboarding" "$profiles" "$settings"
}

support_snapshot() {
  if ! have python3; then printf 'error: python3 is required for support snapshots\n' >&2; exit 16; fi
  status_json | python3 "$DIAGNOSTICS"
}

support_copy() {
  if ! have wl-copy; then printf 'error: wl-copy is required to copy the support snapshot\n' >&2; exit 16; fi
  support_snapshot | wl-copy
  printf '%s\n' '{"ok":true,"action":"support.copy"}'
}

run_action() {
  local action="${1:-}" arg="${2:-}"
  case "$action" in
    mode.enable) mode_enable ;;
    mode.disable) mode_disable ;;
    mode.toggle) mode_toggle ;;
    privacy.enable) if ! privacy_enable; then printf 'error: Omarchy notification DND is unavailable; privacy mode was not enabled\n' >&2; exit 5; fi ;;
    privacy.disable) privacy_disable ;;
    obs.launch) obs_launch ;;
    health.refresh) status_json ;;
    stream.start|stream.stop|record.start|record.stop|clip.save|replay.start|replay.stop|scene.set) run_obs_action "$action" "$arg" ;;
    mic.select|mic.next|mic.mute|mic.unmute|mic.toggle|mic.volume) run_audio_action "$action" "$arg" ;;
    workspace.enter|workspace.exit|safety.refresh|window.check) run_safety_action "$action" ;;
    emergency.end-live|emergency.stop-all) emergency_action "$action" ;;
    collab.create|collab.rotate|collab.reset|collab.open-director|collab.copy-invite|collab.copy-program|collab.slot-rotate|collab.copy-slot-invite|collab.copy-slot-source|collab.obs-add-program|collab.obs-add-slot|collab.guest-refresh|collab.guest-mute|collab.guest-unmute|collab.guest-disconnect) run_collab_action "$action" "$arg" ;;
    collab.layout) run_layout_action "$arg" ;;
    profile.apply|profile.next|profile.previous) run_profile_action "$action" "$arg" ;;
    profile.layout) profile_layout ;;
    settings.set|settings.reset) run_settings_action "$action" "$arg" ;;
    state.migrate) run_migration ;;
    support.snapshot) support_snapshot ;;
    support.copy) support_copy ;;
    onboarding.open) onboarding_open "$arg" ;;
    onboarding.complete|onboarding.reset) run_onboarding_action "$action" ;;
    *) printf 'error: unknown action: %s\n' "$action" >&2; exit 2 ;;
  esac
}

ensure_migrated

case "${1:-status}" in
  status|doctor) status_json ;;
  support) support_snapshot ;;
  action) run_action "${2:-}" "${3:-}" ;;
  *) printf 'usage: %s {status|doctor|support|action <name> [arg]}\n' "$0" >&2; exit 2 ;;
esac